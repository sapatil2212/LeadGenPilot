# ─────────────────────────────────────────────────────────────
# NexaLeadAi — Environment Configuration TEMPLATE
#
# Copy to ".env" and fill in real values. This file contains
# PLACEHOLDERS ONLY and is the single tracked config contract.
# Never put a real credential in this file.
# ─────────────────────────────────────────────────────────────

# ── Server ──
# "development" | "production". Production hides internal error details.
NODE_ENV="development"
# Most PaaS platforms inject PORT automatically — leave unset there.
PORT="3000"
HOST="0.0.0.0"
# Public URL where this app is hosted (used for self-referential links).
APP_URL=""

# ── Security ──
# When set, all /api/* routes require this key via "X-API-Key" or
# "Authorization: Bearer <key>". NOTE: this is a single shared secret that
# identifies no user — it is NOT a substitute for the session cookie.
API_KEY=""
# Comma-separated allowed browser origins. Do NOT use "*" in production:
# the CORS layer echoes the request Origin and sets Allow-Credentials: true.
CORS_ORIGINS="http://localhost:3000"
# "false" only for HTTP-only deployments without TLS. Prefer "true".
COOKIE_SECURE="true"
# Rate limiting (per client IP, per process — in-memory store).
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="300"
# Max request body size, e.g. "1mb", "500kb".
BODY_LIMIT="1mb"

# ── Logging ──
# debug | info | warn | error
LOG_LEVEL="info"
LOG_MAX_BYTES="5242880"

# ── Database (MySQL via Prisma) ──
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=""

# ── Authentication ──
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=""
AUTH_SESSION_DAYS="7"
AUTH_COOKIE_NAME="nexaleadai_session"
# HttpOnly cookie containing the server-validated active workspace id.
AUTH_TENANT_COOKIE_NAME="nexaleadai_tenant"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_SECONDS="30"
APP_NAME="NexaLeadAi"
MAX_FAILED_LOGINS="5"
LOCKOUT_MINUTES="15"

# Encryption key for stored integration credentials (SMTP / WhatsApp Cloud).
# 32+ characters. Generate with: openssl rand -hex 32
# WARNING: rotating this value makes every existing stored integration
# undecryptable — tenants silently fall back to platform defaults.
ENCRYPTION_KEY=""

# Comma-separated emails auto-granted the admin role on sign-in (bootstrap).
ADMIN_EMAILS=""
# Superadmin console credentials (compared against these env values).
ADMIN_PASSWORD=""
SUPERADMIN_SECRET=""

# ── AI providers ──
# Google Gemini. Falls back to the rule-based engine when unset.
GEMINI_API_KEY=""
# OpenRouter. NOTE: the code reads OPENROUTER_API_KEY (src/aiInsights.ts).
# A variable named OPEN_ROUTER_API is ignored and the provider is skipped.
OPENROUTER_API_KEY=""

# ── Google Sheets ──
# Deployed Google Apps Script Web App URL used to push/fetch leads.
GOOGLE_SHEET_WEBHOOK_URL=""

# ── Email (SMTP) ──
# Platform-level fallback mailbox. Per-tenant SMTP is configured in-app and
# stored encrypted; this account is used when a tenant has none.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Email reply ingestion (IMAP) ──
# Derived from SMTP_HOST when unset (smtp.* → imap.*).
IMAP_HOST=""
IMAP_PORT="993"
EMAIL_POLL_INTERVAL_MS="60000"

# ── WhatsApp Business Cloud API (Meta) ──
# Per-tenant credentials are entered in the dashboard and stored encrypted.
# Public HTTPS base URL of this server, used to build the webhook callback.
PUBLIC_BASE_URL=""
# Optional fallback verify token so the first webhook subscription can succeed
# before any tenant has saved credentials.
META_WEBHOOK_VERIFY_TOKEN=""
# Graph API version override. Defaults to v21.0 when unset.
META_GRAPH_VERSION=""

# ── Playwright (lead discovery browser) ──
# Force headless regardless of the in-app toggle.
PLAYWRIGHT_HEADLESS=""
# Point at a system Chrome/Chromium instead of Playwright's download.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
